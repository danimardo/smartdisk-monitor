# Dependencias
node_modules/

# Compilación
build/
.svelte-kit/
src-tauri/target/
src-tauri/gen/

# Informes generados
coverage/

# Datos locales de desarrollo (nunca ProgramData en dev, engineering-conventions §6)
.dev-data/

# Clave de demostración de la ayuda con IA para compilar en local (ADR-054). NUNCA se versiona:
# `set SDM_OPENROUTER_DEMO_KEY=… && pnpm app:build`, o un fichero local que exporte la variable.
src-tauri/.env.local
.env.local

# Editor y sistema
.vscode/
.idea/
Thumbs.db
desktop.ini

# Salidas de herramientas
.playwright-mcp/
*.log

# Salidas de Playwright: trazas, capturas y vídeos de las ejecuciones fallidas.
# Son artefactos de diagnóstico, no fuentes; en CI se suben como artefacto del job.
test-results/
playwright-report/
blob-report/
.playwright/

# Símbolos de depuración de DiskSpd: la descarga oficial trae el .pdb junto al .exe; no se
# redistribuye (ADR-053, THIRD_PARTY_NOTICES.md), solo el ejecutable y la licencia.
third-party/diskspd/bin/*.pdb

# Marketing y multimedia pesada
Marketing/Videos/

