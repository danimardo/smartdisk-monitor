{
  "name": "smartdisk-monitor",
  "private": true,
  "version": "0.2.0",
  "description": "Supervisión local de discos para Windows",
  "author": "Daniel Diez Mardomingo",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build && node scripts/rename-installer.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify": "pnpm verify:assets && pnpm verify:tokens && pnpm verify:i18n && pnpm verify:boundaries",
    "docs:build": "python tools/build-historias.py",
    "docs:screenshots": "node tools/screenshots.mjs",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "docs:check": "python tools/build-historias.py --check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:component": "vitest run --config vitest.browser.config.ts",
    "test:component:watch": "vitest --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.4.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^17.12.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "zod": "^4.5.4"
  }
}
