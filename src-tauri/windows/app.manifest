<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Manifiesto de Windows de SmartDisk Monitor.

       La aplicación se ejecuta SIEMPRE elevada (ADR-004): leer SMART, consultar el registro de
       eventos de almacenamiento y ejecutar `chkdsk` requieren privilegios de administrador, y
       elevar todo el proceso simplifica el acceso frente a un servicio auxiliar aparte.

       Se acepta a cambio que UAC aparezca en cada inicio. La mitigación es la política de
       capacidades de Tauri con mínimo privilegio: sin shell genérica desde JavaScript y comandos
       privilegiados cerrados en Rust. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Sin esto, Windows aplica el comportamiento de compatibilidad de versiones antiguas: las APIs
       de versión mienten y el renderizado puede cambiar. Se declaran los sistemas soportados. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 / Server 2012 R2 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Consciente de DPI por monitor: la ventana debe verse correcta al 125 %, 150 % y 200 %
           de escalado, y al mover la ventana entre pantallas con escalados distintos
           (open-questions.md §L). -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
